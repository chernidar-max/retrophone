<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0806"
    android:padding="20dp">

    <!-- Корпус ретро-телевізора -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tvChassis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tv_chassis_bg"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonRow">

        <!-- Екран кінескопа -->
        <FrameLayout
            android:id="@+id/screenFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="3:4">

            <android.opengl.GLSurfaceView
                android:id="@+id/glSurfacePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Меню налаштувань — виводиться поверх екрана телевізора -->
            <ScrollView
                android:id="@+id/menuOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EE0A0806"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙ МЕНЮ НАЛАШТУВАНЬ"
                        android:textColor="#DAA520"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Рівень шуму та перешкод:"
                        android:textColor="#E0C097"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekNoise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="50"
                        android:progress="18"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Опуклість лінзи кінескопа:"
                        android:textColor="#E0C097"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekCurvature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="30"
                        android:progress="12"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#3E4A2E"
                        android:text="Обрати фото фону 🖼"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnApplyWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#B87333"
                        android:text="Перевстановити живі шпалери"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnCloseMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#3A3530"
                        android:text="Закрити меню ✕"
                        android:textColor="#E0C097" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Панель керування телевізором -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#3A3530"
            android:text="CH −"
            android:textColor="#8A8378"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#8B2500"
            android:text="⏻ УВІМК"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#3A3530"
            android:text="☰ Меню"
            android:textColor="#E0C097"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnChUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#3A3530"
            android:text="CH +"
            android:textColor="#8A8378"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
