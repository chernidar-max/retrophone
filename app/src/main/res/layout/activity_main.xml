<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0806"
    android:padding="20dp">

    <!-- Корпус ретро-телевізора -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tvChassis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tv_chassis_bg"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Квадратний згладжений екран кінескопа — у верхній половині корпусу -->
        <FrameLayout
            android:id="@+id/screenFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/tv_screen_frame_bg"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1">

            <android.opengl.GLSurfaceView
                android:id="@+id/glSurfacePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Меню налаштувань — виводиться поверх екрана телевізора -->
            <ScrollView
                android:id="@+id/menuOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EE0A0806"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙ МЕНЮ НАЛАШТУВАНЬ"
                        android:textColor="#DAA520"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Рівень шуму та перешкод:"
                        android:textColor="#E0C097"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekNoise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="50"
                        android:progress="18"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Опуклість лінзи кінескопа:"
                        android:textColor="#E0C097"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekCurvature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="30"
                        android:progress="12"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#3E4A2E"
                        android:text="Обрати фото фону 🖼"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnApplyWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#B87333"
                        android:text="Перевстановити живі шпалери"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnCloseMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#3A3530"
                        android:text="Закрити меню ✕"
                        android:textColor="#E0C097" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Панель керування: фізичні тумблери + декоративні ручки -->
        <LinearLayout
            android:id="@+id/controlDeck"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/screenFrame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Ряд тумблерів: Живлення (функціональний), Меню (функціональний) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="40dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ЖИВЛЕННЯ"
                        android:textColor="#8A8378"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <FrameLayout
                        android:id="@+id/switchPowerTrack"
                        android:layout_width="52dp"
                        android:layout_height="88dp"
                        android:background="@drawable/switch_track_bg">

                        <View
                            android:id="@+id/switchPowerLever"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="44dp"
                            android:background="@drawable/switch_lever_off_bg" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="МЕНЮ"
                        android:textColor="#8A8378"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <FrameLayout
                        android:id="@+id/switchMenuTrack"
                        android:layout_width="52dp"
                        android:layout_height="88dp"
                        android:background="@drawable/switch_track_bg">

                        <View
                            android:id="@+id/switchMenuLever"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="44dp"
                            android:background="@drawable/switch_lever_off_bg" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Ряд ручок: Канал / Гучність / Яскравість — декоративні -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="КАНАЛ"
                        android:textColor="#6B6156"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:id="@+id/knobChannel"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/knob_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ГУЧНІСТЬ"
                        android:textColor="#6B6156"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:id="@+id/knobVolume"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/knob_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ЯСКРАВІСТЬ"
                        android:textColor="#6B6156"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:id="@+id/knobBrightness"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/knob_bg" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
